{
  "id": "image-to-image-krea2",
  "name": "Krea 2: фото и промт",
  "description": "Редактирование фотографии с сохранением внешности, привязкой к исходнику и финальным качественным апскейлом.",
  "requires_image": true,
  "nodes": {
    "1": {"class_type": "UNETLoader", "inputs": {"unet_name": "{{diffusion_model}}", "weight_dtype": "default"}},
    "2": {"class_type": "CLIPLoader", "inputs": {"clip_name": "{{text_encoder}}", "type": "krea2", "device": "default"}},
    "3": {"class_type": "VAELoader", "inputs": {"vae_name": "{{vae}}"}},
    "4": {"class_type": "LoadImage", "inputs": {"image": "{{input_image}}"}},
    "5": {"class_type": "AspectRatioSimplifier", "inputs": {"max_resolution": "{{max_longest_side}}", "resolution_source": "{{edit_use_custom_size}}", "aspect_ratio": "custom", "custom_width": "{{width}}", "custom_height": "{{height}}", "swap_dimensions": "Off", "upscale_method": "lanczos", "proportion": "crop", "crop_location": "center", "pad_color": "0, 0, 0", "divisible_by": 8, "batch_size": 1, "image": ["4", 0]}},
    "6": {"class_type": "VAEEncode", "inputs": {"pixels": ["5", 0], "vae": ["3", 0]}},
    "7": {"class_type": "LoraLoaderModelOnly", "inputs": {"model": ["1", 0], "lora_name": "{{identity_lora}}", "strength_model": 1}},
    "8": {"class_type": "Krea2EditModelPatch", "inputs": {"model": ["7", 0], "source_latent": ["6", 0], "source_latent_b": ["21", 0], "ref_boost": "{{reference_boost}}", "ref_boost_a": 1, "fit_mode": "fit", "vae": ["3", 0], "source_image": ["5", 0], "source_image_b": ["20", 0]}},
    "9": {"class_type": "Krea2EditGroundedEncode", "inputs": {"clip": ["2", 0], "prompt": "{{positive_prompt}}", "image": ["5", 0], "image_b": ["20", 0], "grounding_px": "{{grounding_pixels}}", "system_prompt": ""}},
    "10": {"class_type": "ConditioningZeroOut", "inputs": {"conditioning": ["9", 0]}},
    "11": {"class_type": "KSampler", "inputs": {"model": ["8", 0], "seed": "{{seed}}", "steps": "{{steps}}", "cfg": "{{cfg}}", "sampler_name": "{{sampler}}", "scheduler": "{{scheduler}}", "positive": ["9", 0], "negative": ["10", 0], "latent_image": ["5", 4], "denoise": "{{denoise}}"}},
    "12": {"class_type": "VAEDecode", "inputs": {"samples": ["11", 0], "vae": ["3", 0]}},
    "13": {"class_type": "UpscaleModelLoader", "inputs": {"model_name": "1xSkinContrast-SuperUltraCompact.pth"}},
    "14": {"class_type": "UltimateSDUpscale", "inputs": {"image": ["12", 0], "model": ["7", 0], "positive": ["9", 0], "negative": ["10", 0], "vae": ["3", 0], "upscale_model": ["13", 0], "upscale_by": "{{upscale_factor}}", "seed": "{{seed}}", "steps": "{{upscale_steps}}", "cfg": "{{upscale_cfg}}", "sampler_name": "{{upscale_sampler}}", "scheduler": "{{upscale_scheduler}}", "denoise": "{{upscale_denoise}}", "mode_type": "None", "tile_width": 512, "tile_height": 512, "mask_blur": 8, "tile_padding": 304, "seam_fix_mode": "None", "seam_fix_denoise": 1, "seam_fix_width": 64, "seam_fix_mask_blur": 8, "seam_fix_padding": 16, "force_uniform_tiles": true, "tiled_decode": false, "batch_size": 1}},
    "15": {"class_type": "LCImageDenoise", "inputs": {"image": ["14", 0], "blur_strength": "{{post_denoise_blur}}", "edge_preservation": "{{post_denoise_edge}}", "radius_multiplier": "{{post_denoise_radius}}", "strength": "{{post_denoise_strength}}"}},
    "16": {"class_type": "LCSkinBeauty", "inputs": {"image": ["15", 0], "preset": "{{skin_preset}}", "strength": "{{skin_strength}}", "coolness": "{{skin_coolness}}", "brightness": "{{skin_brightness}}", "rosy": "{{skin_rosy}}", "evenness": "{{skin_evenness}}", "shadow_lift": "{{skin_shadow_lift}}", "smooth": "{{skin_smooth}}", "texture_preserve": "{{skin_texture_preserve}}", "saturation": "{{skin_saturation}}", "highlight_protect": "{{skin_highlight_protect}}", "mask_sensitivity": "{{skin_mask_sensitivity}}", "mask_feather": "{{skin_mask_feather}}"}},
    "17": {"class_type": "LCImageAdjust", "inputs": {"image": ["16", 0], "hue": "{{adjust_hue}}", "saturation": "{{adjust_saturation}}", "brightness": "{{adjust_brightness}}", "contrast": "{{adjust_contrast}}", "sharpness": "{{adjust_sharpness}}"}},
    "18": {"class_type": "LCApplyLUT", "inputs": {"image": ["17", 0], "lut_name": "{{lut_name}}", "strength": "{{lut_strength}}", "log": true}},
    "19": {"class_type": "SaveImage", "inputs": {"filename_prefix": "AI-Gateway-Krea2-Edit", "images": ["18", 0]}},
    "20": {"class_type": "LoadImage", "inputs": {"image": "{{input_image_2}}"}},
    "21": {"class_type": "VAEEncode", "inputs": {"pixels": ["20", 0], "vae": ["3", 0]}}
  }
}
