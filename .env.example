POSTGRES_DB=ai_gateway
POSTGRES_USER=ai_gateway
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://ai_gateway:change-me@postgres:5432/ai_gateway?sslmode=disable

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-random-32-bytes-or-more
PUBLIC_BASE_URL=https://gateway.example.com
ADMIN_BASE_URL=http://127.0.0.1:8091
PUBLIC_ADDR=:8090
ADMIN_ADDR=:8091
COOKIE_SECURE=true
SESSION_TTL=168h
SESSION_IDLE_TIMEOUT=24h
ACCOUNT_LOCK_THRESHOLD=10
ACCOUNT_LOCK_DURATION=15m

# Dependency probes run independently from historical metrics. A failed
# dependency first becomes stale and only then offline, so one missed probe
# does not create a false outage while old telemetry is never shown as live.
DEPENDENCY_CHECK_INTERVAL=10s
DEPENDENCY_STALE_AFTER=45s
DEPENDENCY_OFFLINE_AFTER=3m

# ComfyUI exposes a large node schema. Gateway refreshes it in the background
# and may use the explicitly labelled last-known-good copy during a short outage.
COMFY_OBJECT_INFO_CACHE_TTL=30s
COMFY_OBJECT_INFO_MAX_STALE=24h

# Heap protection for uploads, archives, gallery reuse and vision references.
# Large single files may use the whole budget, while smaller files can share it.
MEDIA_INFLIGHT_LIMIT_MB=256
MEDIA_SPOOL_DIR=/var/lib/gateway-spool

# Private admin-listener profiling. Keep disabled unless collecting a local
# profile; routes are never registered on the public listener.
PPROF_ENABLED=false

# Unified data-lifetime policy. Generation history and generated files use the
# same value so the gallery never keeps an entry whose result has disappeared.
GENERATION_RETENTION=24h
PINNED_GENERATION_RETENTION=720h
AI_CONTENT_RETENTION=168h
COMFY_INPUT_RETENTION=72h
HOST_METRIC_RETENTION=168h
AUDIT_LOG_RETENTION=2160h
PROXY_REQUEST_RETENTION=2160h
WEBSOCKET_SESSION_RETENTION=720h
GENERATION_REQUEST_RETENTION=168h
DAILY_USAGE_RETENTION=2160h
INVITE_HISTORY_RETENTION=2160h

# Each maintenance pass removes at most batch-size * max-batches rows from a
# managed table. This keeps cleanup bounded even after a long outage.
DATABASE_CLEANUP_BATCH_SIZE=1000
DATABASE_CLEANUP_MAX_BATCHES=20

# List only the reverse proxies that are allowed to supply X-Forwarded-* headers.
# Add the LAN ranges that may access the administration listener.
TRUSTED_PROXIES=127.0.0.1,::1
ADMIN_ALLOWED_CIDRS=127.0.0.1/32,::1/128

COMFYUI_UPSTREAM=http://host.docker.internal:8088
OPENWEBUI_UPSTREAM=http://openwebui:8080
OLLAMA_UPSTREAM=http://host.docker.internal:11434
CONTENT_MODERATOR_UPSTREAM=http://content-moderator:8080
PROMPT_ASSISTANT_MODEL=huihui_ai/gemma-4-abliterated:e4b
# Requests with attached images use the dedicated multimodal model.
PROMPT_ASSISTANT_VISION_MODEL=huihui_ai/Qwen3.8-abliterated:27b-q8_0
PROMPT_ASSISTANT_IMAGE_NUM_PREDICT=900
PROMPT_ASSISTANT_IMAGE_THINK_NUM_PREDICT=1600
PROMPT_ASSISTANT_VIDEO_NUM_PREDICT=2400
PROMPT_ASSISTANT_VIDEO_THINK_NUM_PREDICT=4096
PROMPT_ASSISTANT_IMAGE_TIMEOUT=120s
PROMPT_ASSISTANT_VIDEO_TIMEOUT=240s
# 0 unloads the local model after every request and keeps idle RAM/VRAM usage predictable.
PROMPT_ASSISTANT_KEEP_ALIVE=0
# Keep a vision model warm only long enough to process the next dataset image.
PROMPT_ASSISTANT_VISION_TIMEOUT=5m
PROMPT_ASSISTANT_VISION_KEEP_ALIVE=30s

# Enable only with the coordinated schema/agent release and inference overlay.
LORA_CAPTION_DURABLE_INFERENCE=false
PROMPT_ASSISTANT_DURABLE_JOBS=false
INFERENCE_WORKER_URL=http://inference-worker:8096
# Native inference-worker only: absolute persistent directory; Compose mounts its own volume.
# INFERENCE_OUTCOME_DIR=C:/ProgramData/AI-Gateway/inference-outcomes
# Native worker only. Direct mode cannot recover unknown requests after a crash.
# Do not run the direct Compose worker alongside a windows-owned worker.
INFERENCE_RUNTIME=direct
# windows-owned requires a coordinated Windows launch, schema 70, and a dedicated port.
# INFERENCE_MODEL_EXECUTABLE=C:/Program Files/Ollama/ollama.exe
# INFERENCE_MODEL_DIRECTORY=C:/AI/ollama-models
# INFERENCE_MODEL_STATE_DIR=C:/ProgramData/AI-Gateway/inference-model-owner
# INFERENCE_MODEL_ADDR=127.0.0.1:11445

# Gateway: enable only after coordinated native-worker/OpenWebUI rollout and bypass removal.
# Requires both durable-inference flags above and MINING_FENCED_COMMANDS=true.
OLLAMA_GPU_GUARD_REQUIRED=false
OLLAMA_GPU_GUARD_TOKEN=
# Native worker only: optional guarded Ollama/OpenAI-compatible listener.
# Keep these settings in the native worker environment, not the shared Compose env.
# Bind an explicit loopback/private IP; no wildcard, and not INFERENCE_MODEL_ADDR.
# INFERENCE_OLLAMA_ADDR=192.168.1.86:11446
# INFERENCE_OLLAMA_CLIENT_KEY=<independent random client key, 32-256 characters>
# INFERENCE_OLLAMA_ADMISSION_URL=http://192.168.1.86:8091/internal/gpu/ollama/permit
# INFERENCE_OLLAMA_ADMISSION_KEY=<same secret as Gateway OLLAMA_GPU_GUARD_TOKEN>
# Client and admission keys must differ. Do not route existing clients automatically.

# Authenticated Windows host-agent used to control mining processes.
MINING_AGENT_URL=http://host.docker.internal:8092
MINING_AGENT_TOKEN=change-me-random-32-bytes-or-more
# Requires mining-agent require_fenced_commands=true and coordinated F04/F14 rollout.
MINING_FENCED_COMMANDS=false

# Read-only Windows host metrics. It may share the mining-agent token, but a
# separate token is recommended when both agents are installed.
SYSTEM_MONITOR_AGENT_URL=http://host.docker.internal:8094
SYSTEM_MONITOR_AGENT_TOKEN=change-me-random-32-bytes-or-more

# Optional Windows host-agent for checking and installing Gateway, ComfyUI,
# and Open WebUI updates. The installer generates the token securely.
UPDATE_AGENT_URL=http://host.docker.internal:8093
UPDATE_AGENT_TOKEN=

# Image-only LoRA training agent. The Windows installer creates a separate
# Musubi environment, the token, and model profiles without restarting ComfyUI.
LORA_TRAINING_AGENT_URL=http://host.docker.internal:8095
LORA_TRAINING_AGENT_TOKEN=

# Required to accept user suggestions with links or JSON attachments. The key
# is kept only in .env and is never included in the repository or UI.
VIRUSTOTAL_API_KEY=
FEATURE_SUGGESTIONS_ENABLED=false

# Optional, needed when the existing upstream nginx services require basic auth.
COMFYUI_UPSTREAM_USERNAME=
COMFYUI_UPSTREAM_PASSWORD=
OPENWEBUI_UPSTREAM_USERNAME=
OPENWEBUI_UPSTREAM_PASSWORD=
