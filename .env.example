POSTGRES_DB=ai_gateway
POSTGRES_USER=ai_gateway
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://ai_gateway:change-me@postgres:5432/ai_gateway?sslmode=disable

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-random-32-bytes-or-more
PUBLIC_BASE_URL=https://gateway.example.com
ADMIN_BASE_URL=http://127.0.0.1:8091
PUBLIC_ADDR=:8090
ADMIN_ADDR=:8091
COOKIE_SECURE=true
SESSION_TTL=168h
SESSION_IDLE_TIMEOUT=24h
ACCOUNT_LOCK_THRESHOLD=10
ACCOUNT_LOCK_DURATION=15m

# Dependency probes run independently from historical metrics. A failed
# dependency first becomes stale and only then offline, so one missed probe
# does not create a false outage while old telemetry is never shown as live.
DEPENDENCY_CHECK_INTERVAL=10s
DEPENDENCY_STALE_AFTER=45s
DEPENDENCY_OFFLINE_AFTER=3m

# Unified data-lifetime policy. Generation history and generated files use the
# same value so the gallery never keeps an entry whose result has disappeared.
GENERATION_RETENTION=24h
AI_CONTENT_RETENTION=168h
COMFY_INPUT_RETENTION=72h
HOST_METRIC_RETENTION=168h
AUDIT_LOG_RETENTION=2160h

# List only the reverse proxies that are allowed to supply X-Forwarded-* headers.
# Add the LAN ranges that may access the administration listener.
TRUSTED_PROXIES=127.0.0.1,::1
ADMIN_ALLOWED_CIDRS=127.0.0.1/32,::1/128

COMFYUI_UPSTREAM=http://host.docker.internal:8088
OPENWEBUI_UPSTREAM=http://openwebui:8080
OLLAMA_UPSTREAM=http://host.docker.internal:11434
CONTENT_MODERATOR_UPSTREAM=http://content-moderator:8080
PROMPT_ASSISTANT_MODEL=huihui_ai/gemma-4-abliterated:e4b

# Authenticated Windows host-agent used to control mining processes.
MINING_AGENT_URL=http://host.docker.internal:8092
MINING_AGENT_TOKEN=change-me-random-32-bytes-or-more

# Read-only Windows host metrics. It may share the mining-agent token, but a
# separate token is recommended when both agents are installed.
SYSTEM_MONITOR_AGENT_URL=http://host.docker.internal:8094
SYSTEM_MONITOR_AGENT_TOKEN=change-me-random-32-bytes-or-more

# Optional Windows host-agent for checking and installing Gateway, ComfyUI,
# and Open WebUI updates. The installer generates the token securely.
UPDATE_AGENT_URL=http://host.docker.internal:8093
UPDATE_AGENT_TOKEN=

# Required to accept user suggestions with links or JSON attachments. The key
# is kept only in .env and is never included in the repository or UI.
VIRUSTOTAL_API_KEY=
FEATURE_SUGGESTIONS_ENABLED=false

# Optional, needed when the existing upstream nginx services require basic auth.
COMFYUI_UPSTREAM_USERNAME=
COMFYUI_UPSTREAM_PASSWORD=
OPENWEBUI_UPSTREAM_USERNAME=
OPENWEBUI_UPSTREAM_PASSWORD=
